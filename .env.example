# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Как часто проверять сайты, секунд (600 = 10 минут)
CHECK_INTERVAL=600

# Как часто проверять, когда цель уже найдена в афише (билеты разбирают быстро)
CHECK_INTERVAL_HOT=120

# Тихая строчка про новые посторонние фильмы: 1 присылать, 0 молчать
NEW_FILM_DIGEST=1

# Таймаут запроса к сайтам кинотеатров, секунд
HTTP_TIMEOUT=30

# Кому слать технические ошибки (0 значит всем подписчикам)
ADMIN_CHAT_ID=0
